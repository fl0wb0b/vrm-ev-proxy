# Datenquelle: vrm (Standard) oder ble (Tesla per Bluetooth über TeslaBleHttpProxy)
DATA_SOURCE=vrm
# nur bei ble: Adresse des TeslaBleHttpProxy und VINs der Autos (kommasepariert)
BLE_URL=
BLE_VINS=
VRM_TOKEN=hier_deinen_vrm_api_token_eintragen
VRM_SITE_ID=hier_deine_installation_id_eintragen
POLL_INTERVAL=60
PORT=8080
# evcc-Adresse (IP:Port), optional; leer = evcc-Funktionen aus
EVCC_URL=
